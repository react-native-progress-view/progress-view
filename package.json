{
  "name": "@react-native-community/progress-view",
  "version": "2.0.2",
  "description": "React Native Progress View iOS Library",
  "keywords": [
    "ProgressViewIOS",
    "progress",
    "progress view",
    "react native",
    "react-native"
  ],
  "homepage": "https://github.com/react-native-progress-view/progress-view#readme",
  "bugs": {
    "url": "https://github.com/react-native-progress-view/progress-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-progress-view/progress-view.git"
  },
  "license": "MIT",
  "author": "Kaiden Sin <ksnz93@gmail.com>",
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "files": [
    "common",
    "android",
    "ios",
    "js",
    "macos",
    "react-native-progress-view.podspec",
    "windows"
  ],
  "scripts": {
    "android": "react-native run-android",
    "flow": "flow",
    "generate:android-manifest": "node node_modules/react-native-test-app/android/android-manifest.js example/app.json example/android/app/build/generated/rnta/src/main/AndroidManifest.xml",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "macos": "react-native run-macos --scheme ReactTestApp",
    "release": "release-it",
    "start": "react-native start",
    "test": "jest js/__tests__/*",
    "type-check": "tsc --noEmit",
    "windows": "react-native run-windows --sln example/windows/ProgressViewExample.sln"
  },
  "jest": {
    "preset": "react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rnx-kit/metro-config": "^2.2.6",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.4",
    "eslint": "^8.19.0",
    "flow-bin": "^0.275.0",
    "hermes-eslint": "^0.37.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-test-app": "^5.4.17",
    "react-native-windows": "0.81.42",
    "react-test-renderer": "19.1.4",
    "release-it": "^21.1.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  },
  "codegenConfig": {
    "name": "progressview",
    "type": "components",
    "jsSrcsDir": "./js",
    "android": {
      "javaPackageName": "com.reactnativecommunity.progressview"
    },
    "ios": {
      "componentProvider": {
        "RNCProgressView": "RNCProgressViewComponentView"
      }
    }
  },
  "packageManager": "yarn@4.19.0"
}
